{
  "description": "RFC 8707 resource URI canonicalization vectors shared by internal/iam/oauth (CanonicalResource), sdk/resourceserver (Canonical) and @iamkit/node/resource-server (canonicalResource). canonical null means the input is refused.",
  "cases": [
    {"name": "root without slash", "input": "https://mcp.example.com", "canonical": "https://mcp.example.com"},
    {"name": "root slash removed", "input": "https://mcp.example.com/", "canonical": "https://mcp.example.com"},
    {"name": "path trailing slash removed", "input": "https://mcp.example.com/mcp/", "canonical": "https://mcp.example.com/mcp"},
    {"name": "path kept", "input": "https://mcp.example.com/mcp", "canonical": "https://mcp.example.com/mcp"},
    {"name": "scheme and host lowercased", "input": "HTTPS://MCP.Example.COM/mcp", "canonical": "https://mcp.example.com/mcp"},
    {"name": "path case kept", "input": "https://mcp.example.com/Tenant/MCP", "canonical": "https://mcp.example.com/Tenant/MCP"},
    {"name": "explicit default https port removed", "input": "https://mcp.example.com:443/mcp", "canonical": "https://mcp.example.com/mcp"},
    {"name": "explicit default http port removed", "input": "http://localhost:80/mcp", "canonical": "http://localhost/mcp"},
    {"name": "other port kept", "input": "https://mcp.example.com:8443/mcp", "canonical": "https://mcp.example.com:8443/mcp"},
    {"name": "loopback http with port", "input": "http://127.0.0.1:3000/mcp", "canonical": "http://127.0.0.1:3000/mcp"},
    {"name": "loopback ipv6 http", "input": "http://[::1]:3000/mcp", "canonical": "http://[::1]:3000/mcp"},
    {"name": "localhost uppercase", "input": "http://LOCALHOST:3000/mcp/", "canonical": "http://localhost:3000/mcp"},
    {"name": "percent encoding compared as is", "input": "https://mcp.example.com/a%2Fb", "canonical": "https://mcp.example.com/a%2Fb"},
    {"name": "punycode host", "input": "https://xn--bcher-kva.example/mcp", "canonical": "https://xn--bcher-kva.example/mcp"},
    {"name": "http not loopback", "input": "http://mcp.example.com/mcp", "canonical": null},
    {"name": "query refused", "input": "https://mcp.example.com/mcp?tenant=a", "canonical": null},
    {"name": "empty query refused", "input": "https://mcp.example.com/mcp?", "canonical": null},
    {"name": "fragment refused", "input": "https://mcp.example.com/mcp#x", "canonical": null},
    {"name": "userinfo refused", "input": "https://user@mcp.example.com/mcp", "canonical": null},
    {"name": "dot dot segment refused", "input": "https://mcp.example.com/a/../mcp", "canonical": null},
    {"name": "dot segment refused", "input": "https://mcp.example.com/./mcp", "canonical": null},
    {"name": "encoded dot segment refused", "input": "https://mcp.example.com/a/%2e%2e/mcp", "canonical": null},
    {"name": "empty segment refused", "input": "https://mcp.example.com//mcp", "canonical": null},
    {"name": "double trailing slash refused", "input": "https://mcp.example.com/mcp//", "canonical": null},
    {"name": "non ascii host refused", "input": "https://bücher.example/mcp", "canonical": null},
    {"name": "space refused", "input": "https://mcp.example.com/my mcp", "canonical": null},
    {"name": "bad percent encoding refused", "input": "https://mcp.example.com/a%zz", "canonical": null},
    {"name": "relative refused", "input": "/mcp", "canonical": null},
    {"name": "other scheme refused", "input": "ftp://mcp.example.com/mcp", "canonical": null},
    {"name": "missing host refused", "input": "https:///mcp", "canonical": null},
    {"name": "empty port refused", "input": "https://mcp.example.com:/mcp", "canonical": null},
    {"name": "port out of range refused", "input": "https://mcp.example.com:70000/mcp", "canonical": null},
    {"name": "port leading zero refused", "input": "https://mcp.example.com:0443/mcp", "canonical": null},
    {"name": "trailing dot host refused", "input": "https://mcp.example.com./mcp", "canonical": null},
    {"name": "empty input refused", "input": "", "canonical": null}
  ]
}
