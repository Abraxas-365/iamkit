{
  "name": "iamkit-mcp-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A remote MCP server (Streamable HTTP) protected by IAMKit as its OAuth 2.1 authorization server, with @iamkit/node/resource-server",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "stack": "bash scripts/stack.sh"
  },
  "dependencies": {
    "@iamkit/node": "file:../../clients/node",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
