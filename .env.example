# Local only. Load explicitly with: set -a; . ./.env; set +a
DATABASE_URL=postgres://iamkit:iamkit_local@localhost:55432/iamkit?sslmode=disable
SERVER_PORT=8080
JWT_PRIVATE_KEY_PATH=.dev-secrets/jwt.pem
JWT_ISSUER=http://localhost:8080

# Optional OAuth server. Set a stable, random secret of at least 32 bytes.
# Use HTTPS JWT_ISSUER for browser authorization/federation cookies.
OIDC_HMAC_SECRET=

# Deployment-wide email (environments without their own configuration).
# EMAIL_PROVIDER: webhook (default), smtp or resend. See docs/reference/configuration.md#email.
EMAIL_PROVIDER=
# webhook: trusted HTTPS delivery service. Payload: email, purpose, code.
# Redirects are refused. Do not log the payload; codes expire after 5 minutes.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# smtp / resend: IAMKit writes the email. Local mail catcher (Mailpit):
# EMAIL_PROVIDER=smtp EMAIL_FROM=no-reply@localhost.test SMTP_HOST=127.0.0.1 SMTP_PORT=1025
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
# Default email language: en, es (empty = English).
EMAIL_LOCALE=
# DEVELOPMENT ONLY: let environment email webhooks / SMTP servers (console →
# Notifications) reach localhost and private networks. Never true in
# production: operators could make the server call internal services.
IAMKIT_ALLOW_PRIVATE_DELIVERY=false

# Deployment-controlled JSON binding, exact environment + issuer + client + secret.
# Operators cannot select another environment's provider credential.
# Example (replace every value):
# FEDERATION_CREDENTIAL_BINDINGS='[{"environment_id":"ENV_UUID","issuer":"https://accounts.google.com","client_id":"REGISTERED_CLIENT_ID","secret_env":"IAMKIT_PROVIDER_GOOGLE"}]'
FEDERATION_CREDENTIAL_BINDINGS='[]'
# IAMKIT_PROVIDER_GOOGLE=your-private-provider-client-secret

# Encrypts stored secrets such as organization SSO client secrets and
# environment SMTP passwords / Resend API keys (AES-256-GCM). Base64 of 32
# random bytes: openssl rand -base64 32.
# Required to store those secrets. Back it up: without it
# stored secrets cannot be decrypted. To rotate, move the old key to
# IAMKIT_ENCRYPTION_KEYS_OLD (comma-separated, decrypt-only) and set a new one.
IAMKIT_ENCRYPTION_KEY=
IAMKIT_ENCRYPTION_KEYS_OLD=

# Optional: replicas share rate limits and per-minute usage limits and cache a
# few hot reads in Redis. PostgreSQL stays the source of truth; IAMKit keeps
# working (per replica) while Redis is down.
# REDIS_URL=redis://localhost:6379/0
